PORT=3000
OPEN_ACCESS=false
# Banco local por padrão. Para Neon/produção:
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
# ADMIN_PASSWORD=UmaSenhaForteParaPrimeiroAcesso
# DATA_DIR=./data
# Origem pública HTTPS, sem credenciais, caminho, query ou fragmento:
# APP_URL=https://sua-academia.onrender.com
# Desenvolvimento com e-mail: APP_URL=http://localhost:3000
# E-mails transacionais (Resend, remetente/domínio verificado):
# RESEND_API_KEY=
# MAIL_FROM=Signy <acesso@seu-dominio.com>
# Recuperação/convite e fila financeira usam o mesmo serviço.
# Consultar entrega requer chave com permissão de leitura de e-mails.
# A fila financeira é processada pelo servidor a cada 30 segundos.
# Pagamento online (Mercado Pago Checkout Pro):
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# MP_SANDBOX=true
# Localização, raio, precisão e horário: configurar como administrador na interface.
# HTTPS e proxy corretamente configurado são necessários para check-in em produção.
# Telemetria: tempos e contagem SQL, sem corpos de requisição ou senhas:
# PERFORMANCE_LOG=true
# OPEN_ACCESS=true é permitido somente em demonstração local, fora de production.
