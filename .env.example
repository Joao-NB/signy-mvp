PORT=3000
# Configure antes da primeira execução. Sem esta variável, uma senha aleatória é exibida no terminal.
ADMIN_PASSWORD=SubstituaPorUmaSenhaForte
# Caminho opcional para o banco PostgreSQL embarcado:
# DATA_DIR=./data
# Hospedagem gratuita: conexão PostgreSQL fornecida pelo Neon, incluindo sslmode=require.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
