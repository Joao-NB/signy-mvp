PORT=3000
# Opcional e mantido apenas para automação. Sem esta variável, a primeira
# conta administrativa é criada com segurança pela página inicial.
# ADMIN_PASSWORD=SubstituaPorUmaSenhaForte
# Caminho opcional para o banco PostgreSQL embarcado:
# DATA_DIR=./data
# Hospedagem gratuita: conexão PostgreSQL fornecida pelo Neon, incluindo sslmode=require.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
